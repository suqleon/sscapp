# Copy to .env (never commit .env). EXPO_PUBLIC_* variables are inlined into
# the app bundle at build time — only the anon/public key belongs here, never
# the service_role key. Without these the app runs in demo mode with sample data.

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
